<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <TextureView
        android:id="@+id/textureView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Bar Atas: Status & Toggle Penting -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#88000000"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="6dp">

        <Button
            android:id="@+id/btnFlip"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="FLIP: ON"
            android:textSize="11sp" />

        <Button
            android:id="@+id/btnEis"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="6dp"
            android:text="EIS: ON"
            android:textSize="11sp" />

        <Button
            android:id="@+id/btnLsc"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="6dp"
            android:text="LSC FIX: ON"
            android:textSize="11sp" />

        <Button
            android:id="@+id/btnTone"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="6dp"
            android:text="TONE: NETRAL"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Panel Bawah: Hanya Pengaturan Esensial -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="#99000000"
        android:orientation="vertical"
        android:padding="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/txtStrength"
                android:layout_width="135dp"
                android:layout_height="wrap_content"
                android:text="Kuat Tone: 70%"
                android:textColor="#FFD700"
                android:textSize="12sp" />
            <SeekBar
                android:id="@+id/seekStrength"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="100"
                android:progress="70" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/txtIso"
                android:layout_width="135dp"
                android:layout_height="wrap_content"
                android:text="ISO: 200"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />
            <SeekBar
                android:id="@+id/seekIso"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="3200"
                android:min="100"
                android:progress="200" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/txtShutter"
                android:layout_width="135dp"
                android:layout_height="wrap_content"
                android:text="Shutter: 1/60s"
                android:textColor="#00FFCC"
                android:textSize="12sp" />
            <SeekBar
                android:id="@+id/seekShutter"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="500"
                android:min="25"
                android:progress="60" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/txtWb"
                android:layout_width="135dp"
                android:layout_height="wrap_content"
                android:text="WB: 5200K"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />
            <SeekBar
                android:id="@+id/seekWb"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="8000"
                android:min="2500"
                android:progress="5200" />
        </LinearLayout>
    </LinearLayout>

    <Button
        android:id="@+id/btnRecord"
        android:layout_width="68dp"
        android:layout_height="68dp"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:layout_marginEnd="14dp"
        android:backgroundTint="#D32F2F"
        android:text="REC"
        android:textColor="#FFFFFF"
        android:textStyle="bold" />
</RelativeLayout>
