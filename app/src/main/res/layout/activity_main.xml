<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <TextureView
        android:id="@+id/textureView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Bar Tombol Atas -->
    <HorizontalScrollView
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:background="#66000000"
        android:padding="6dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnRotate"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginEnd="6dp"
                android:text="LAYAR: VERTIKAL"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btnFlip"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginEnd="6dp"
                android:text="FLIP: ON"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btnEis"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginEnd="6dp"
                android:text="EIS: ON"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btnLsc"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginEnd="6dp"
                android:text="LSC FIX: ON"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btnTone"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:text="TONE: NETRAL"
                android:textSize="11sp" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Tombol Shutter FOTO & VIDEO di Sisi Kanan -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:layout_marginEnd="14dp"
        android:gravity="center"
        android:orientation="vertical">

        <Button
            android:id="@+id/btnPhoto"
            android:layout_width="74dp"
            android:layout_height="52dp"
            android:layout_marginBottom="14dp"
            android:backgroundTint="#FFFFFF"
            android:text="FOTO"
            android:textColor="#000000"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnRecord"
            android:layout_width="74dp"
            android:layout_height="52dp"
            android:backgroundTint="#D32F2F"
            android:text="REC"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Panel Kontrol Manual Bawah -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="#66000000"
        android:orientation="vertical"
        android:padding="10dp">

        <TextView
            android:id="@+id/txtStrength"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Kuat Tone: 70%"
            android:textColor="#FFC107"
            android:textSize="12sp" />

        <SeekBar
            android:id="@+id/seekStrength"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:progress="70" />

        <TextView
            android:id="@+id/txtIso"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ISO: 200"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />

        <SeekBar
            android:id="@+id/seekIso"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="3200"
            android:min="100"
            android:progress="200" />

        <TextView
            android:id="@+id/txtShutter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Shutter: 1/60s"
            android:textColor="#00E5FF"
            android:textSize="12sp" />

        <SeekBar
            android:id="@+id/seekShutter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="1000"
            android:min="10"
            android:progress="60" />

        <TextView
            android:id="@+id/txtWb"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="WB: 5200K"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />

        <SeekBar
            android:id="@+id/seekWb"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="8000"
            android:min="2500"
            android:progress="5200" />
    </LinearLayout>

</RelativeLayout>
